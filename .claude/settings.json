{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m mypy:*)",
      "Bash(python -m ruff:*)",
      "Bash(mypy:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(python examples/:*)",
      "Bash(pip install:*)",
      "Bash(pip show:*)",
      "Bash(python -m venv:*)",
      "Bash(python -m build:*)",
      "Bash(mdbook:*)",
      "Bash(uv:*)"
    ],
    "deny": [
      "Bash(twine:*)",
      "Bash(python -m twine:*)",
      "Bash(git push:*)",
      "Read(./**/*.creds)",
      "Read(./**/key.txt)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/adapter-drift.sh"
          }
        ]
      }
    ]
  }
}
